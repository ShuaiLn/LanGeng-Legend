# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm only: package-lock.json is the lockfile)
/node_modules

# next.js
/.next/
/out/

# production
/build

# typescript (both are regenerated by `next dev` / `tsc`)
*.tsbuildinfo
next-env.d.ts

# testing
/coverage
# opt-in balance harness output (game/core/__tests__/calibrate.test.ts: the default file names)
/calibrate.*.json

# logs
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets
*.pem

# deploy
.vercel

# Claude Code: keep local settings and worktrees out of the repo
/.claude/settings.local.json
/.claude/worktrees/

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# NOT ignored on purpose: public/game/ is generated by `npm run assets:build` from assets/,
# but `npm run build` does not run it, so the published files must be committed.
